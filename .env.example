# Example .env file for Gy-Data-Hub
# Copy to .env and fill with your real secrets in Render (do NOT commit real secrets).

# Server
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgres://user:password@host:5432/dbname
PGSSLMODE=disable

# Sessions
SESSION_SECRET=change_me_long_random_value
SESSION_COOKIE_NAME=gyd_sid
SESSION_COOKIE_SECURE=true

# CORS
CORS_ORIGINS=https://example.com

# OpenAI (optional)
OPENAI_API_KEY=

# Monnify (payment gateway)
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=monnify_api_key_placeholder
MONNIFY_SECRET_KEY=monnify_secret_key_placeholder
MONNIFY_CONTRACT_CODE=monnify_contract_code_placeholder
MONNIFY_WEBHOOK_SECRET=monnify_webhook_secret_placeholder

# ClubKonnect (airtime/data provider)
CLUBKONNECT_USER_ID=clubkonnect_user_id_placeholder
CLUBKONNECT_API_KEY=clubkonnect_api_key_placeholder
CLUBKONNECT_BASE_URL=https://nellobytesystems.com
CLUBKONNECT_WEBHOOK_SECRET=clubkonnect_webhook_secret_placeholder

# WhatsApp / Meta (optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PIN=changeme

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Frontend
FRONTEND_DIST_DIR=public
