name: GY DATA Android Build & GitHub Release

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build-android:
    name: Build Android APK + AAB
    runs-on: ubuntu-latest

    env:
      ANDROID_HOME: /usr/local/lib/android/sdk
      ANDROID_SDK_ROOT: /usr/local/lib/android/sdk
      JAVA_HOME: /opt/hostedtoolcache/Java_Temurin-Hotspot_jdk/21.0.8-9/x64
      VITE_API_URL: https://gy-data-hub-1.onrender.com

    defaults:
      run:
        shell: bash

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 10.17.1
          run_install: false

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm
          cache-dependency-path: pnpm-lock.yaml

      - name: Verify Node and pnpm
        run: |
          node --version
          pnpm --version

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build web application
        working-directory: artifacts/gy-data
        env:
          VITE_API_URL: https://gy-data-hub-1.onrender.com
        run: pnpm build

      - name: Add Android platform
        working-directory: artifacts/gy-data
        run: pnpm exec cap add android

      - name: Sync Capacitor Android
        working-directory: artifacts/gy-data
        run: pnpm exec cap sync android

      - name: Generate Android branding
        working-directory: artifacts/gy-data
        run: pnpm android:branding

      - name: Copy Android web assets
        working-directory: artifacts/gy-data
        run: pnpm exec cap copy android

      - name: Setup Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
          cache: gradle

      - name: Verify Android SDK
        run: |
          echo "ANDROID_HOME=$ANDROID_HOME"
          echo "ANDROID_SDK_ROOT=$ANDROID_SDK_ROOT"

          ls -la "$ANDROID_HOME"

          if [ ! -x "$ANDROID_HOME/platform-tools/adb" ]; then
            echo "ERROR: Android platform-tools not found."
            exit 1
          fi

          echo "Android SDK packages:"
          "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --list_installed || true

      - name: Install required Android SDK packages
        run: |
          SDKMANAGER="$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager"

          if [ ! -x "$SDKMANAGER" ]; then
            SDKMANAGER="$ANDROID_HOME/cmdline-tools/16.0/bin/sdkmanager"
          fi

          if [ ! -x "$SDKMANAGER" ]; then
            echo "ERROR: sdkmanager was not found."
            find "$ANDROID_HOME/cmdline-tools" -maxdepth 3 -type f -name sdkmanager -print || true
            exit 1
          fi

          yes | "$SDKMANAGER" --licenses >/dev/null || true

          "$SDKMANAGER" \
            "platform-tools" \
            "platforms;android-35" \
            "build-tools;35.0.0"

      - name: Verify Android SDK packages
        run: |
          test -d "$ANDROID_HOME/platforms/android-35"
          test -d "$ANDROID_HOME/build-tools/35.0.0"
          test -x "$ANDROID_HOME/platform-tools/adb"

          echo "Android SDK verification successful."

      - name: Make Gradle executable
        working-directory: artifacts/gy-data/android
        run: chmod +x gradlew

      - name: Configure release signing
        working-directory: artifacts/gy-data/android
        env:
          KEYSTORE_BASE64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
          KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
        run: |
          set -e

          if [ -n "$KEYSTORE_BASE64" ] && \
             [ -n "$KEYSTORE_PASSWORD" ] && \
             [ -n "$KEY_ALIAS" ] && \
             [ -n "$KEY_PASSWORD" ]; then

            echo "Release signing secrets detected."

            echo "$KEYSTORE_BASE64" | base64 --decode > gy-data-release.keystore

            if [ ! -s gy-data-release.keystore ]; then
              echo "ERROR: Keystore could not be created."
              exit 1
            fi

            cat >> gradle.properties <<EOF

          GY_DATA_RELEASE_STORE_FILE=gy-data-release.keystore
          GY_DATA_RELEASE_STORE_PASSWORD=$KEYSTORE_PASSWORD
          GY_DATA_RELEASE_KEY_ALIAS=$KEY_ALIAS
          GY_DATA_RELEASE_KEY_PASSWORD=$KEY_PASSWORD
          EOF

            python3 - <<'PY'
          from pathlib import Path

          path = Path("app/build.gradle")
          text = path.read_text()

          signing_block = r'''
              signingConfigs {
                  release {
                      if (project.hasProperty("GY_DATA_RELEASE_STORE_FILE")) {
                          storeFile file(GY_DATA_RELEASE_STORE_FILE)
                          storePassword GY_DATA_RELEASE_STORE_PASSWORD
                          keyAlias GY_DATA_RELEASE_KEY_ALIAS
                          keyPassword GY_DATA_RELEASE_KEY_PASSWORD
                      }
                  }
              }
          '''

          if "signingConfigs {" not in text:
              marker = "android {"
              if marker not in text:
                  raise SystemExit("Could not find android { block in app/build.gradle")
              text = text.replace(
                  marker,
                  marker + "\n" + signing_block,
                  1
              )

          if "signingConfig signingConfigs.release" not in text:
              marker = "buildTypes {"
              if marker not in text:
                  raise SystemExit("Could not find buildTypes block in app/build.gradle")

              replacement = '''buildTypes {
                  release {
                      signingConfig signingConfigs.release
                  }
              '''

              text = text.replace(marker, replacement, 1)

          path.write_text(text)
          PY

            echo "Release signing configured."

          else
            echo "WARNING: Android signing secrets are not configured."
            echo "Building unsigned release artifacts."
          fi

      - name: Show Android Gradle configuration
        working-directory: artifacts/gy-data/android
        run: |
          echo "Gradle version:"
          ./gradlew --version

          echo "Android build.gradle:"
          sed -n '1,240p' app/build.gradle

      - name: Clean Gradle project
        working-directory: artifacts/gy-data/android
        run: ./gradlew clean --no-daemon

      - name: Build release APK
        working-directory: artifacts/gy-data/android
        run: ./gradlew assembleRelease --no-daemon --stacktrace

      - name: Build release AAB
        working-directory: artifacts/gy-data/android
        run: ./gradlew bundleRelease --no-daemon --stacktrace

      - name: Locate Android artifacts
        working-directory: artifacts/gy-data
        run: |
          echo "APK files:"
          find android/app/build/outputs/apk -type f -name "*.apk" -print || true

          echo "AAB files:"
          find android/app/build/outputs/bundle -type f -name "*.aab" -print || true

      - name: Prepare release files
        working-directory: artifacts/gy-data
        run: |
          set -e

          mkdir -p release

          APK_PATH="$(find android/app/build/outputs/apk -type f
